#!/bin/bash
# Starts only the daemon in NewPat's marked, dedicated distribution.
set -euo pipefail
trap 'printf "NewPat: runtime startup interrupted.\n" >&2; exit 130' INT TERM

if [[ "${1:-}" != "ensure" || $# -ne 1 ]]; then
    printf 'Usage: newpat-engine ensure\n' >&2
    exit 2
fi
if [[ $(id -u) -ne 0 ]]; then
    printf 'NewPat: the dedicated runtime must be started as root.\n' >&2
    exit 2
fi
if [[ ! -f /etc/newpat-runtime-id ]] || \
        [[ $(cat /etc/newpat-runtime-id) != "newpat-runtime-v1" ]]; then
    printf 'NewPat: refusing to start Docker in an unrecognized distribution.\n' >&2
    exit 2
fi
python3 - <<'PY'
import json
import sys
from pathlib import Path
try:
    marker = json.loads(Path('/etc/newpat-runtime.json').read_text())
    sys.path.insert(0, '/usr/local/lib/newpat')
    from component import component_identity
    if marker.get('component_sha256') != component_identity(marker):
        raise ValueError('component identity mismatch')
except (OSError, ValueError) as error:
    raise SystemExit(f'NewPat: invalid dedicated-runtime marker: {error}')
PY

unset DOCKER_HOST DOCKER_CONTEXT DOCKER_TLS_VERIFY DOCKER_CERT_PATH
socket='unix:///var/run/docker.sock'
ready() {
    timeout 5 docker --host "$socket" info --format '{{.ServerVersion}}' >/dev/null 2>&1
}
install -d -m 0755 /run/lock /var/log/newpat
exec 9>/run/lock/newpat-engine.lock
if ! flock --wait 120 9; then
    printf 'NewPat: another runtime startup is still in progress. Retry shortly.\n' >&2
    exit 1
fi
if ready; then
    exit 0
fi

pidfile=/run/newpat-dockerd.pid
if [[ -f "$pidfile" ]]; then
    pid=$(cat "$pidfile")
    if [[ ! "$pid" =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$pidfile"
    fi
fi
if [[ ! -f "$pidfile" ]]; then
    # Do not inherit descriptor 9: the daemon must not retain the startup lock.
    nohup dockerd --host "$socket" --pidfile "$pidfile" \
        --data-root /var/lib/docker --exec-root /run/newpat-docker \
        </dev/null >>/var/log/newpat/dockerd.log 2>&1 9>&- &
fi
deadline=$((SECONDS + 90))
while ((SECONDS < deadline)); do
    if ready; then
        exit 0
    fi
    sleep 1
done
printf 'NewPat: Docker did not become ready. See /var/log/newpat/dockerd.log in this distribution.\n' >&2
tail -n 30 /var/log/newpat/dockerd.log >&2 || true
exit 1
